{
  "name": "container-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "doctor": "node host/src/doctor.js",
    "build:image": "docker build -t wc-agent:latest agent",
    "host": "node host/src/index.js",
    "client": "vite --config client/vite.config.js",
    "dev": "concurrently -k -n host,client -c cyan,magenta \"npm run host\" \"npm run client\"",
    "build:client": "vite build --config client/vite.config.js"
  },
  "dependencies": {
    "dockerode": "^4.0.2",
    "http-proxy": "^1.18.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "monaco-editor": "^0.52.0",
    "vite": "^5.4.0"
  }
}