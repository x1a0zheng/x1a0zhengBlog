{
  "name": "esbuild-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run server\" \"npm run client\"",
    "build:client": "vite build --config client/vite.config.js"
  },
  "dependencies": {
    "antd": "^6.5.1",
    "esbuild": "^0.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "monaco-editor": "^0.52.0",
    "vite": "^5.4.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
